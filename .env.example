# ══════════════════════════════════════════════
# TRADING BOT CONFIGURATION v8 — Copy to .env
#
# v8 (Momentum TSM): the COMBINED engine, Velarde/agent/council, and the
# per-profile threshold knobs were removed. The two momentum sleeves
# (momentum_stocks on Alpaca, momentum_crypto on Binance Futures) are
# ALWAYS ON with walk-forward-validated parameters hard-wired in code.
# ══════════════════════════════════════════════

TRADING_MODE=paper

# Maintenance kill-switch. Default when UNSET: trading ENABLED — prod
# auto-deploys master and does not set this variable, so the default MUST
# keep it trading. Set the literal string "false" to block ONLY new opens:
# everything else (dashboard, syncs, stop-loss, closes of existing
# positions) keeps running.
# TRADING_ENABLED=false

# ── Accounts and portfolios (docs/platform/self-hosting.md) ───────────────
# A new installation manages both from the dashboard: broker accounts in
# "Accounts" (keys checked read-only against the broker, then stored
# encrypted with data/master.key — or Alpaca OAuth with your own app) and
# portfolios in "Portfolios". Changes apply on the next restart. Delete these
# two lines and the bot signs with the ALPACA_*/BINANCE_* keys below and
# builds the portfolios shipped in the code instead (the behavior of
# installations that predate the platform).
ACCOUNTS_SOURCE=registry
PORTFOLIOS_SOURCE=db
# With more than one verified account of a broker, choose the one the bot
# trades by its id in "Accounts" (or instance.json runtimeAccounts).
# RUNTIME_ACCOUNT_ALPACA=
# RUNTIME_ACCOUNT_BINANCE=

# ── LIVE-arming ceremony (src/config/index.ts assertRequiredConfig) ────────
# Only enforced when ALPACA_PAPER=false or ALPACA_BASE_URL isn't a known
# paper host — with today's ALPACA_PAPER=true, none of this applies. Going
# live additionally requires TRADING_MODE=live (above) AND a hand-created
# marker file data/.live-armed whose content is EXACTLY this value.
LIVE_ACCOUNT_ID=

# ── Alpaca (Stocks) — get keys from https://app.alpaca.markets/paper/dashboard/overview
# The bot reads these only with ACCOUNTS_SOURCE=env; the scripts under
# scripts/ (historical-bar refresh, certification) read them directly.
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# Market-data feed: iex (default) or sip when subscribed.
ALPACA_DATA_FEED=iex

# ── Binance Futures Testnet (Crypto execution)
# Same rule as Alpaca: the bot reads these only with ACCOUNTS_SOURCE=env.
BINANCE_FUTURES_API_KEY=your_binance_futures_key
BINANCE_FUTURES_SECRET_KEY=your_binance_futures_secret
# demo-fapi.binance.com and testnet.binancefuture.com are the same sandbox
# backend (same book/account/keys); Binance is migrating to demo-fapi.
BINANCE_FUTURES_REST_BASE=https://demo-fapi.binance.com
# USDⓈ-M REST transport: "legacy" (hand-rolled signed fetch, default) or
# "sdk" (official @binance/derivatives-trading-usds-futures client).
# Rollback from sdk = set this back to legacy (or delete the line) + restart.
BINANCE_TRANSPORT=legacy

# ── Binance public market data (no execution keys needed)
# Public 1h klines feed the crypto sleeve's candles. Kill switch (falls back
# to Alpaca crypto bars):
BINANCE_KLINES=true
BINANCE_KLINES_URL=https://fapi.binance.com

# ── Optional certified sleeves (2026-07-19) — momentum_crypto_usdc /
# momentum_btc. BOTH default false. Each runs its own startup preflight
# (testnet host, one-way position mode, single-asset margin mode, an
# existing balance row, TRADING exchangeInfo filters) BEFORE it's wired; a
# failure hard-fails ONLY that sleeve. Enable after running
# `bun run scripts/certify-usdc-coinm.ts --execute` successfully on the
# SAME testnet keys. Reuses BINANCE_FUTURES_API_KEY/SECRET_KEY unless
# BINANCE_COINM_API_KEY/SECRET_KEY are set for a dedicated COIN-M key.
MOMENTUM_USDC_ENABLED=false
MOMENTUM_COINM_ENABLED=false
# COIN-M (DAPI) demo/testnet REST base — never a live host.
BINANCE_COINM_REST_BASE=https://demo-dapi.binance.com
BINANCE_COINM_API_KEY=
BINANCE_COINM_SECRET_KEY=
# Seed value shown before the first sync; runtime risk re-anchors to the
# actual DAPI wallet marginBalance × mark (never used to size orders).
MOMENTUM_BTC_INITIAL_USD=1000

# ── Telegram Notifications ───────────────────
# TWO AUDIENCES (2026-08-03). TELEGRAM_CHAT_ID is the END USER's chat and
# only ever receives trading events: every buy/sell fill, every close with
# its P&L, trading paused/resumed by a circuit breaker, the daily digest,
# and replies to /status /trades /help.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# OPTIONAL operator chat: error bursts, unexpected restarts, watchdog
# restarts and deploy results go here INSTEAD of the user chat. Leave it
# EMPTY and those events are written to the logs only — never to the user.
# There is deliberately no fallback to TELEGRAM_CHAT_ID.
TELEGRAM_OPS_CHAT_ID=

# ── Dashboard ────────────────────────────────
# `bun run setup` saves the port in data/instance.json. Set it here only to
# override that (env beats instance.json).
# DASHBOARD_PORT=3789
# ── Self-hosted platform (optional — see docs/platform/self-hosting.md) ───
# Everything below is OPTIONAL and additive: unset, the bot behaves exactly
# as before. Most installations should run `bun run setup` instead, which
# writes <dataDir>/instance.json; env always wins over instance.json.
# Bind host for the dashboard listener (default 0.0.0.0 = all interfaces).
# DASHBOARD_HOST=127.0.0.1
# Public URL when the dashboard is reachable through a tunnel/proxy, e.g.
# https://bot.example.com — adds its origin to the WS allowlist, switches
# session cookies to Secure (explicit DASHBOARD_COOKIE_SECURE still wins),
# and is the base for the OAuth callback URLs.
# PUBLIC_URL=
# Data directory holding instance.json / master.key (default ./data).
# UC_DATA_DIR=
# Master key for the secret store (32 bytes, base64 or hex). Normally left
# unset: `bun run setup` creates <dataDir>/master.key (0600) instead.
# UC_MASTER_KEY=
# Owner OAuth login (both optional; normally configured via `bun run setup`).
# GitHub: allowlist is your NUMERIC account id (https://api.github.com/users/<login>).
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_ALLOWED_ID=
# OAUTH_GITHUB_ALLOWED_LOGIN=
# Google: allowlist is your verified email (OIDC email_verified required).
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_ALLOWED_EMAIL=
# Env-managed admin login (optional). The owner normally comes from
# `bun run setup` or, with no login configured anywhere, from the first-run
# page at /setup (its one-time token is printed in the log). Set these only to
# manage the admin through env, which wins over instance.json on the same
# username. Generate the hash with:
#   bun -e "console.log(await Bun.password.hash('change-me-now'))"
# DASHBOARD_ADMIN_USER=admin
# DASHBOARD_ADMIN_PASSWORD_HASH=
# DASHBOARD_ADMIN_DISPLAY_NAME=Admin
# Optional READ-ONLY 2nd user (role "viewer"): can watch the dashboard but
# cannot mutate (no admin routes, no WS switch_view). Hand this out for routine
# monitoring instead of the admin credential. Leave blank to disable.
DASHBOARD_VIEWER_USER=
DASHBOARD_VIEWER_PASSWORD_HASH=
DASHBOARD_VIEWER_DISPLAY_NAME=Viewer
# Session cookies are Secure when PUBLIC_URL is https. Set false only while
# testing over plain http on a LAN.
# DASHBOARD_COOKIE_SECURE=false
DASHBOARD_LOGIN_MAX_ATTEMPTS=8
DASHBOARD_LOGIN_WINDOW_MS=900000
DASHBOARD_LOGIN_LOCK_MS=900000
LOG_LEVEL=INFO
# Production hardening (optional): METRICS_TOKEN for Prometheus scrapers,
# DASHBOARD_ALLOWED_ORIGINS (CSV) + TRUST_PROXY=true behind a reverse proxy.
METRICS_TOKEN=
DASHBOARD_ALLOWED_ORIGINS=
TRUST_PROXY=false

# ── Backups (scripts/backup-db.sh) ───────────
# Local backups always run (data/backups/, 14 daily + 8 weekly). Optionally
# also copy each VERIFIED daily backup OFF-HOST so a host failure doesn't lose
# it. An off-host failure only warns; the local backup still succeeds.
# A path that is physically elsewhere (NFS/SMB/rclone mount, secondary disk):
BACKUP_OFFHOST_DIR=
# OR an rsync/scp target (needs key-based SSH from the bot host):
BACKUP_REMOTE=

# ── Risk engine — absolute per-order $ cap (src/risk/RiskEngine.ts) ────────
# Hard ceiling independent of every sleeve's percentage-based sizing — a
# typo'd base/leverage input can't blow past this. Default 25000 already
# covers today's largest real slot (momentum_stocks ~$25k at 2x) so it
# changes nothing that currently happens.
RISK_MAX_NOTIONAL_PER_ORDER_USD=25000
# Optional per-sleeve override, e.g. RISK_MAX_NOTIONAL_PER_ORDER_USD_MEANREV_STOCKS=10000
# RISK_MAX_NOTIONAL_PER_ORDER_USD_<SLEEVE>=

# ── Execution WS ─────────────────────────────
# EXECUTION_WS=true subscribes to broker user-data streams (Alpaca
# trade_updates, Binance Futures listenKey/userDataStream) so order updates
# arrive in <1s. REST polling fallback stays active either way.
EXECUTION_WS=false

# ── MeanRev stocks sleeve (meanrev_stocks) ───
# Daily RSI2 mean-reversion on a disjoint stock universe. One pass per ET
# trading day ≥ 09:35. Default ON; set false to skip wiring.
MEANREV_ENABLED=true
# Fixed base notional (slot = 10% of this; NO equity feedback loop).
MEANREV_BASE_USD=50000

# ── Execution policy (limit chaser, src/executor/executionPolicy.ts) ───
# OPT-IN, per-sleeve, keyed by account id. UNSET/absent = every sleeve trades
# raw MARKET orders, exactly as before — this is the safe default and the
# only behavior ever exercised outside an explicit opt-in.
#
# The example below is the ONLY sleeve with a measured, adverse execution
# cost so far (first 30d slippage instrumentation, 2026-08-06): momentum_
# crypto_usdc pays +5.34bps adverse average over 29 fills (momentum_stocks
# -3.69bps and meanrev_stocks -142.8bps are neutral/favorable — the meanrev
# number is the overnight gap, not execution, see AUDITS.md). It's also the
# best-suited sleeve for a limit chaser: 24/7 perp market (no session-open
# gap risk), 60min rebalance cadence, and p50 hold ~20h — a decision has a
# LOT of slack relative to a chase measured in seconds.
#
# entry (limit_chase, chaseLimit — NO market fallback: an unfilled entry
# just waits for the next 60min rebalance, missing one is fine):
#   offsetBps=3          sit 3bps behind the touch (passive) — aims to claw
#                        back roughly the measured +5.34bps without offering
#                        away so much of the spread that the order rarely
#                        fills inside one decision window.
#   refreshThresholdBps=4  hysteresis: only reprice once the reference has
#                        drifted at least as far as the offset itself, so
#                        ordinary 1-2bps crypto noise doesn't reprice at all.
#   maxReprices=3        bounded chase — entries are optional, no need to
#                        keep chasing a runaway move.
#   maxDistanceBps=15    hard clamp: a repriced entry is never further than
#                        15bps from the live reference.
#   timeoutMs=60000       60s total chase budget — comfortably inside a
#                        single 60min rebalance decision, no urgency to force
#                        a fill (see "NO market fallback" above).
#   pollIntervalMs=3000   20 polls over the 60s budget.
#
# exit (limit_then_market, chaseThenMarket — ALWAYS degrades to MARKET after
# its bounded limit phase, by design; this is the non-negotiable invariant
# that keeps a real exit from ever being stuck polite):
#   offsetBps=2          smaller passive offset than entry — an exit's job is
#                        to actually get out; only shave a couple bps before
#                        the guaranteed market fallback takes over.
#   refreshThresholdBps=3
#   maxReprices=2        fewer reprices than entry — optimizing exit price is
#                        secondary to not delaying the exit.
#   maxDistanceBps=12
#   timeoutMs=20000       SHORT (20s) limit phase — an ordinary momentum
#                        rebalance exit must resolve promptly. (The 15s
#                        stop-loss loop and native GTC stops are separate,
#                        independent protective paths and are NOT affected by
#                        this policy either way.)
#   pollIntervalMs=2000
#
# Blank/absent = market orders for every sleeve (today's behavior). Enable by
# uncommenting; an invalid entry for a given sleeve is DROPPED (that sleeve
# falls back to market, logged loudly) rather than guessed — see
# executionPolicy.ts validatePolicy().
# EXECUTION_POLICY_JSON={"momentum_crypto_usdc":{"entry":{"style":"limit_chase","offsetBps":3,"refreshThresholdBps":4,"maxReprices":3,"maxDistanceBps":15,"timeoutMs":60000,"pollIntervalMs":3000},"exit":{"style":"limit_then_market","offsetBps":2,"refreshThresholdBps":3,"maxReprices":2,"maxDistanceBps":12,"timeoutMs":20000,"pollIntervalMs":2000}}}
