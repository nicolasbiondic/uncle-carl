# ══════════════════════════════════════════════
# systemd-user unit del laboratorio de memecoins (paper, aislado del bot).
# Instalar con: scripts/install-memecoin-lab.sh (renderiza __BUN__/__ROOT__).
# No firma ni envía transacciones; no tiene wallet. Ver labs/memecoin/README.md.
# ══════════════════════════════════════════════

[Unit]
Description=Memecoin lab (paper, pump.fun) — sin wallet
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=__ROOT__
ExecStart=__BUN__ labs/memecoin/main.ts
StandardOutput=append:__ROOT__/logs/memecoin-lab.log
StandardError=append:__ROOT__/logs/memecoin-lab.log

# Vuelve de cualquier salida: el proceso sale con código 2 si su RSS supera
# limits.maxRssMb (mejor reiniciar que crecer) y la unidad lo levanta limpio.
Restart=always
RestartSec=10

# Prioridad baja y recursos acotados: es un laboratorio, nunca compite con el bot.
Nice=10
MemoryHigh=384M
MemoryMax=512M
CPUQuota=30%

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__ROOT__/data __ROOT__/logs
PrivateTmp=true

[Install]
WantedBy=default.target
