{
  "name": "uncle-carl-trading-bot",
  "version": "8.0.0",
  "description": "Uncle Carl Trading Bot v8 — Momentum TSM: Alpaca stocks sleeve + Binance Futures crypto sleeve",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "setup": "bun run scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "baseline": "bun run scripts/baseline-report.ts",
    "verify": "bun run scripts/verify-smoke.ts",
    "verify:deploy": "bun run scripts/verify-deploy.ts",
    "ops:close-crypto": "bun run scripts/close-crypto-now.ts",
    "ops:close-stocks": "bun run scripts/close-stocks-at-open.ts",
    "backtest:momentum-wf": "bun run scripts/backtest-momentum-wf.ts",
    "experiment:wf": "bun run scripts/walk-forward.ts"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "@binance/derivatives-trading-usds-futures": "38.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "uuid": "^13.0.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1"
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "axios": "^1.14.0",
    "follow-redirects": "^1.16.0"
  }
}
